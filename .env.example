# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: Required for sending automated email replies (from Resend dashboard)
RESEND_API_KEY=

# RESEND_FROM_EMAIL: Optional verified sender address (defaults to "The RED Company <connect@theredcompany.co.in>")
RESEND_FROM_EMAIL="The RED Company <connect@theredcompany.co.in>"
